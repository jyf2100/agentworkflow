# hub.env 模板——复制为 hub.env（0600）填真值；hub.env 与 vault.key 均 gitignore 绝不入仓。
# compose 经 env_file 整文件注入（spec: hub-deployment「配置面」）。

# ── 基础六项（2a 起必填）──────────────────────────────────────
HUB_USER_ID=roc
HUB_USER_ANTHROPIC_BASE_URL=https://litellm.example
HUB_USER_ANTHROPIC_AUTH_TOKEN=<roc 的 ANTHROPIC_AUTH_TOKEN>
HUB_USER_GH_TOKEN=<roc 的 GH_TOKEN>
# 完整镜像引用 repo:tag（docker run/inspect 直接消费；勿写纯 tag——docker 会当镜像名找错）
HUB_IMAGE_TAG_DEFAULT=pa-executor:v0.1.40

# ── 凭据保险箱（2a；不配 = env-only 兜底形态）────────────────
# vault.key 的内容（Fernet key，vault-import 用同一把）
#HUB_VAULT_MASTER_KEY=<base64 Fernet key>

# ── MM OAuth 身份（2b；四项全不配 = 2a 回退态：auth 群 503、单用户兜底零变化）──
# 前置：MM 管理员在 系统控制台 → 集成 → OAuth 2.0 应用 注册 confidential client，
# redirect_uri 填 http://<hub-host>:<port>/auth/callback（与部署可达地址一致）。
#HUB_MM_BASE_URL=https://mm.example.com
#HUB_MM_CLIENT_ID=<OAuth app client_id>
#HUB_MM_CLIENT_SECRET=<OAuth app client_secret>
# 会话签名 key（与 vault master key 分离；≥32 字节随机串，如 openssl rand -base64 32）
#HUB_SESSION_SECRET=<random 43+ chars>
# 可选：会话有效期秒数（默认 604800 = 7d）
#HUB_SESSION_TTL_S=604800
# 面板改行为操作白名单（add-hub-panel-console D4）：MM username 逗号分隔；
# 不配/空 = 任何有效会话放行（单用户回退态）。挂守卫的操作：建项目、重跑、放弃
#（提交 PRD 仍是任何有效会话——观察面不收紧）
#HUB_PANEL_ADMINS=rocju

# ── 投递通道 token（slice-3；不配 = 内网无守卫，对齐 GET 面现状）──────────
# vault→hub 机机通道共享 token：配置则 POST /deliver 要求 Authorization: Bearer
# （mac 侧投递器经 env PA_DELIVER_TOKEN 传同值）。公网/多租户暴露前 token +
# socket proxy 是硬门槛（F2 口径，design doc §9）。
#HUB_DELIVER_TOKEN=<random 32+ chars>

# ── MM 通知 bot（4a；不配（或 MM base_url 缺）= 通知通道关闭，零行为零噪音）──
# 前置：MM 管理员在 系统控制台 → 集成 → Bot 帐号 创建 bot（独立于上面 OAuth 2.0
# 应用的第二个凭据实体），并允许该 bot 被目标用户加为 DM 联系人。run 终态私信
# 发起人；失败类终态同时广播项目频道（如配）。回退两级：只 unset HUB_MM_BOT_TOKEN
# = 通知静默（读面守卫不变）；连 MM 四项也 unset = 整体回 2a 回退态。
#HUB_MM_BOT_TOKEN=<bot token>
# 项目频道映射【已废止（add-mm-channel-intake D2）】：仅首次启动且绑定表为空时被
# 一次性 seed 迁移消费，此后本键不再被读取——继续配置静默无效（勿以为生效）。
# 频道↔项目绑定的唯一真相是绑定表（project_channels），经频道内 /pa bind 管理，
# 或清表 + 重配本键重启以重新 seed。
#HUB_MM_PROJECT_CHANNELS=proj-a:chan-id,proj-b:chan-id2

# ── MM 入站 slash command（add-mm-channel-intake；不配 = 入站关闭，端点 503 零行为）──
# 前置：MM 管理员在 系统控制台 → 集成 → Slash Command 创建 /pa，callback URL 填
# http://<hub-host>:<port>/mm/intake，MM 下发 token 回填此键并重建容器。
# 凭据三实体分职：OAuth app（登录身份）/ bot token（出站推递）/ slash token
# （本键，入站校验）——三者独立，互不替代。
#HUB_MM_SLASH_TOKEN=<slash command token>

# ── 镜像陈旧检测（4a；不配 repo = 检测关闭零行为）──────────────
# 比对源 owner/repo（remote 最新 release tag vs HUB_IMAGE_TAG_DEFAULT 的 tag 段——
# release tag 纯 v0.1.34、本地值完整 pa-executor:v0.1.34，比对剥前缀；不一致经
# bot 通道私信 + stderr 告警，去抖一次/组合；hub 绝不自动拉取或重建——升级是
# 人工决定）。检测周期 N tick（默认 720 ≈ 5s tick 下每小时一次）。
#HUB_IMAGE_TEMPLATE_REPO=acme/pa-executor
#HUB_STALE_CHECK_TICKS=720

# ── 远程 runner seed（add-hub-runner-pool 后两键降级为首启一次性迁移）──
# HUB_DOCKER_HOST：**首启 seed**——runners 表空时灌一行（此后面板服务器池表是唯一
# 真相，env 再改静默无效；注册/编辑/禁启用走面板或 API）。表空态值形态坏（非
# tcp://）= 启动 fail loud 拒起。仅 tcp:// 形态（2375 明文无认证=连上即目标机
# root——**仅内网 + 目标机防火墙限源（只放行 hub 宿主 IP），绝不可暴露公网**；
# TLS/2376 不支持，DOCKER_TLS_* 不透传）。
#HUB_DOCKER_HOST=tcp://172.32.153.183:2375
# HUB_RUNNER_MOUNT_ROOT：seed 行的 bind mount 挂载源投影根（daemon 机上该存储的
# 路径名）。部署前提：与 HUB_DATA_ROOT 须指**同一共享存储**（NFS/同盘双挂）——hub
# 写永远走 HUB_DATA_ROOT 路径名，run 容器经本根路径名读写，链路由共享存储闭合。
# 共享存储运行中断链不 fail loud（stamp 防撞依赖它）——监控列入部署前提，见
# RUNBOOK §22。seed 机探针初始记绿（信任部署期人工核实），此后周期探针复核。
#HUB_RUNNER_MOUNT_ROOT=/mnt/nfs/pa
# 服务器池健康探针周期（N tick，默认 60 ≈ 5s tick 下每 5 分钟一轮三项 CLI 探针；
# 探针绿 = 该机参选调度的必要条件——红/未探不派发，见 RUNBOOK §22）
#HUB_PROBE_TICKS=60
# 配置六层漂移看门狗（add-config-drift-watchdog）：模型路由/凭据在六层各自独立存在
# （settings env / 本机路由文件 / hub.env / vault / 网关注册 / 容器实况），层间不一致
# 是「改了无数次都没改回来」类事故的根因。看门狗周期性断言 hub 可达四层（R1-R4），
# 漂移项 MM 私信 + 修复指引，只报不修。周期键（默认 720 ≈ 每小时）；intent 路径由
# compose 固定指 /intent/hub.env（ro 挂载 + 宿主属主对齐，见 compose 注释与 RUNBOOK
# 「配置六层漂移模型」节）——未挂载 = R1 关闭，其余规则照跑。
#HUB_DRIFT_TICKS=720
# runner 镜像自动分发超时（add-runner-image-sync）：探针报「daemon ok 且镜像缺失」时
# hub 自动 save|load 流式分发默认 tag 到该 runner（save 侧本机 daemon / load 侧 2375 面），
# 成功后复测探针转绿回候选；失败 MM 告警 + item 保持 pending。缺省 900s（2.24GB LAN 量级）。
#HUB_IMAGE_SYNC_TIMEOUT=900
# 运维日报周期（add-hub-daily-digest）：队列/池/漂移三面聚合一日一条 MM 私信
# （stderr 同文留痕；未配 bot 降级 stderr）。缺省 17280 ≈ 每日；配超大值即事实关闭。
#HUB_DIGEST_TICKS=17280
# 事件轮询周期（add-event-sources）：项目 sources.yaml 顶层 events: 声明（repo/authors
# GitHub login 授权面/types 白名单）→ hub 周期拉取过筛落 <project>/events/ 语料增量
# （目录存在即自动挂载进 run 容器 .project-auto/events，sources.yaml 配 directory 源
# root: .project-auto/events/ 即进 fetch/radar 链——编排零改动）。缺省 720 ≈ 每小时。
#HUB_EVENT_TICKS=720
# 订阅直通轮询周期（add-thread-subscription）：绑定频道在飞 run 窗口内的授权人话
# （成员三态 Gate，bot 自帖忽略）→ <run_dir>/human_notes/ 落盘 + 频道回执一条汇总
# → 下一 iteration 经 --human-notes 注入 dev prompt（仅上下文非判据）。缺省 24 ≈ 2 分钟。
#HUB_RELAY_TICKS=24
# 主动观察者周期（add-proactive-observer）：profiles 增 proactive 块（mode: observe /
# watch_repos / rules）后，周期盯仓两类机械信号——默认分支 CI 连红（≥ci_red_streak）/
# issue 激增（24h 速率>7d 基线×issue_surge_ratio 且 ≥issue_surge_min）→ 影子提案落
# <project>/shadow_proposals/（仅日报聚合不进执行链；mode: auto 未实装自动降级 observe）。
# 采纳：/pa run 的 evidence 填 shadow-proposal:sp-xxxx（命中率=auto 放量唯一依据）。
#HUB_OBSERVER_TICKS=720
# Router persona 解释层（add-router-persona，默认关）：绑定频道非 slash 自然语言消息经
# 机械预筛（#N run 引用/sp-* 提案/问句关键词）→ 只读 persona 问答 → 频道回帖。
# 与直通互斥（窗外/授权外帖才进 router）；预算闸 HUB_ROUTER_RATE 次/频道/小时。
#PA_ROUTER_PERSONA=1
# dev loop maxBudgetUsd（默认 25；run #109 实证 10 不够 qwen3.8 烧）
PA_DEV_MAX_BUDGET=25
# 发布门 test_stale 自动重验（add-test-gate-auto-triage，默认关）：绿测后又有候选写时
# dev-agent 在 worktree 重跑同条测试命令一次取新证据，绿则复评放行（门语义零放松）、
# 红/超时维持阻断并留 auto_triage 记录。PA_TEST_GATE_TRIAGE_TIMEOUT 缺省 600s。
#PA_TEST_GATE_AUTO_TRIAGE=1
# dev loop 模型（run #118 真机实证）：HUB_USER_MODEL 指 OpenAI 兼容后端（如 Qwen 系列）
# 时，dev loop 的 SDK 多轮消息序列不满足「system message 必须在最前」的后端约束 → 400
# 拒收（persona 的 CLI 单轮形态不受影响）。dev loop 需更稳模型时经本键指定（PA_* 透传
# 链进 run 容器，dev-agent.py 认）；不配 = 走 roc 默认。
#PA_DEV_MODEL=glm-5.2

# ── run 容器 git 代理（远程 runner 真机实证）────────────────────
# 远程 runner 机容器直连 github 被断（Empty reply from server）时，经 git 原生 env 注入
# config 机制（GIT_CONFIG_*，git ≥2.31）给 run 容器配 per-URL 代理——只路由 github 的
# git 流量，LLM/roc 代理流量不经此通道（与 https_proxy 全局 env 的关键差别）。经 PA_*/
# GIT_CONFIG_* 透传链生效（lifecycle container_env），hub 进程 env 同步获得。
#GIT_CONFIG_COUNT=1
#GIT_CONFIG_KEY_0=http.https://github.com/.proxy
#GIT_CONFIG_VALUE_0=http://<proxy-host>:7890
