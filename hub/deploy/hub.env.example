# hub.env 模板——复制为 hub.env（0600）填真值；hub.env 与 vault.key 均 gitignore 绝不入仓。
# compose 经 env_file 整文件注入（spec: hub-deployment「配置面」）。

# ── 基础六项（2a 起必填）──────────────────────────────────────
HUB_USER_ID=roc
HUB_USER_ANTHROPIC_BASE_URL=https://litellm.example
HUB_USER_ANTHROPIC_AUTH_TOKEN=<roc 的 ANTHROPIC_AUTH_TOKEN>
HUB_USER_GH_TOKEN=<roc 的 GH_TOKEN>
HUB_IMAGE_TAG_DEFAULT=pa-executor:v0.1.3

# ── 凭据保险箱（2a；不配 = env-only 兜底形态）────────────────
# vault.key 的内容（Fernet key，vault-import 用同一把）
#HUB_VAULT_MASTER_KEY=<base64 Fernet key>

# ── MM OAuth 身份（2b；四项全不配 = 2a 回退态：auth 群 503、单用户兜底零变化）──
# 前置：MM 管理员在 系统控制台 → 集成 → OAuth 2.0 应用 注册 confidential client，
# redirect_uri 填 http://<hub-host>:<port>/auth/callback（与部署可达地址一致）。
#HUB_MM_BASE_URL=https://mm.example.com
#HUB_MM_CLIENT_ID=<OAuth app client_id>
#HUB_MM_CLIENT_SECRET=<OAuth app client_secret>
# 会话签名 key（与 vault master key 分离；≥32 字节随机串，如 openssl rand -base64 32）
#HUB_SESSION_SECRET=<random 43+ chars>
# 可选：会话有效期秒数（默认 604800 = 7d）
#HUB_SESSION_TTL_S=604800

# ── 投递通道 token（slice-3；不配 = 内网无守卫，对齐 GET 面现状）──────────
# vault→hub 机机通道共享 token：配置则 POST /deliver 要求 Authorization: Bearer
# （mac 侧投递器经 env PA_DELIVER_TOKEN 传同值）。公网/多租户暴露前 token +
# socket proxy 是硬门槛（F2 口径，design doc §9）。
#HUB_DELIVER_TOKEN=<random 32+ chars>
